{
	"name": "kr4chinin.com",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"format": "pnpm dlx prettier --write .",
		"ts": "tsc --noEmit",
		"lint:css:fix": "pnpm dlx stylelint \"**/*.css\" --fix",
		"postinstall": "pnpm dlx simple-git-hooks"
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "^5.2.7",
		"@tailwindcss/vite": "^4.1.14",
		"astro": "^5.14.4",
		"tailwindcss": "^4.1.14"
	},
	"devDependencies": {
		"nano-staged": "^0.8.0",
		"prettier": "^3.6.2",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"simple-git-hooks": "^2.13.1",
		"stylelint": "^16.25.0",
		"stylelint-config-clean-order": "^7.0.0",
		"stylelint-config-standard-scss": "^16.0.0"
	},
	"nano-staged": {
		"*.{ts,astro}": [
			"pnpm format"
		],
		"*.{css}": [
			"pnpm format",
			"pnpm lint:css:fix"
		]
	},
	"simple-git-hooks": {
		"pre-commit": "./node_modules/.bin/nano-staged",
		"pre-push": "pnpm ts"
	}
}
