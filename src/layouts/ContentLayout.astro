---
import Layout from './Layout.astro';

interface Props {
	title: string;
	date: Date;
	backLink: string;
	backLabel: string;
	demoURL?: string;
}

const { title, date, backLink, backLabel, demoURL } = Astro.props;

function formatDate(date: Date) {
	return date.toLocaleDateString('en-us', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}
---

<Layout>
	<main class="flex flex-grow">
		<article class="mx-auto flex w-full max-w-3xl flex-col gap-4 px-4 py-6">
			<div class="py-4">
				<a href={backLink} class="font-bold hover:underline">← {backLabel}</a>
			</div>

			<div class="mb-4 flex flex-col gap-2">
				<h1 class="text-4xl font-bold">{title}</h1>
				<p class="text-sm text-gray-600">{formatDate(date)}</p>
				{
					demoURL && (
						<div class="flex gap-4 text-sm">
							<a
								href={demoURL}
								target="_blank"
								rel="noopener noreferrer"
								class="font-semibold text-blue-600 hover:underline"
							>
								Live Demo →
							</a>
						</div>
					)
				}
			</div>

			<div class="prose prose-stone max-w-none">
				<slot />
			</div>
		</article>
	</main>
</Layout>

<style is:global>
	@reference '../styles/global.css';

	.prose {
		@apply text-gray-800;
	}

	.prose h1,
	.prose h2,
	.prose h3,
	.prose h4,
	.prose h5,
	.prose h6 {
		@apply mt-6 mb-3 leading-tight font-bold;
	}

	.prose h1 {
		@apply text-3xl;
	}

	.prose h2 {
		@apply text-2xl;
	}

	.prose h3 {
		@apply text-xl;
	}

	.prose p {
		@apply mb-4 leading-7;
	}

	.prose a {
		@apply font-semibold text-blue-600 underline transition-colors hover:text-blue-700 active:text-blue-500;
	}

	.prose code {
		@apply rounded bg-gray-200 px-1.5 py-0.5 font-mono text-sm;
	}

	.prose pre {
		@apply my-6 overflow-x-auto rounded-lg bg-gray-800 p-4 text-gray-200;
	}

	.prose pre code {
		@apply bg-transparent p-0 text-sm;
	}

	.prose ul,
	.prose ol {
		@apply my-4 pl-6;
	}

	.prose li {
		@apply my-2;
	}

	.prose blockquote {
		@apply my-6 border-l-4 border-gray-300 pl-4 text-gray-600 italic;
	}

	.prose strong {
		@apply font-bold;
	}

	.prose em {
		@apply italic;
	}

	.prose hr {
		@apply my-8 border-0 border-t border-gray-200;
	}

	.prose img {
		@apply my-6 h-auto max-w-full rounded-lg;
	}

	.prose table {
		@apply my-6 w-full border-collapse;
	}

	.prose th,
	.prose td {
		@apply border border-gray-200 p-2 text-left;
	}

	.prose th {
		@apply bg-gray-100 font-bold;
	}
</style>
