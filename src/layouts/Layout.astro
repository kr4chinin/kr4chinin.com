---
import '../styles/global.css';
import '@fontsource-variable/geist-mono';

const ogImageUrl = new URL('/og.png', Astro.site).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/avatar.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Ilya Kruchinin</title>

		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/brands.min.css"
		/>

		<!-- Open Graph / Twitter cards -->
		<meta property="og:site_name" content="kr4chinin.com" />
		<meta property="og:title" content="Ilya Kruchinin" />
		<meta property="og:description" content="Full Stack Developer" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.site} />

		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Ilya Kruchinin" />
		<meta name="twitter:description" content="Full Stack Developer" />
		<meta name="twitter:image" content={`${Astro.site}/og.png`} />
	</head>

	<body class="flex min-h-screen flex-col bg-stone-100 text-gray-800">
		<slot />
	</body>
</html>
