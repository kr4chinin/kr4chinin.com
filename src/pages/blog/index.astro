---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/Layout.astro';

const posts = (await getCollection('blog'))
	.filter(post => !post.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
	return date.toLocaleDateString('en-us', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
}
---

<Layout>
	<main class="flex flex-grow">
		<div class="mx-auto flex w-full max-w-3xl flex-col gap-4 px-4 py-6">
			<div class="py-4">
				<a href="/" class="font-bold hover:underline">← Home</a>
			</div>

			<div class="mb-6">
				<h1 class="text-3xl font-bold">Blog</h1>
			</div>

			{
				posts.length === 0 ? (
					<p>No posts yet. Check back soon!</p>
				) : (
					<ul class="flex flex-col gap-6">
						{posts.map(post => (
							<li>
								<a href={`/blog/${post.slug}`} class="group block">
									<div class="flex flex-col gap-2">
										<h2 class="text-xl font-bold group-hover:underline">{post.data.title}</h2>
										<p class="text-sm text-gray-600">{formatDate(post.data.date)}</p>
										<p class="text-gray-700">{post.data.description}</p>
									</div>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</main>
</Layout>
