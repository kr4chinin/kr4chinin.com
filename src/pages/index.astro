---
import Footer from '~/components/Footer/Footer.astro';
import AboutHeader from '~/components/About/Header/AboutHeader.astro';
import SocialLink from '~/components/About/Header/SocialLink.astro';
import { Socials } from '~/constants';
import Layout from '~/layouts/Layout.astro';
---

<Layout>
	<AboutHeader />

	<main class="flex flex-grow">
		<div class="mx-auto flex w-full max-w-3xl flex-col px-4 py-6">
			<div class="flex max-w-prose flex-col gap-4 leading-relaxed text-pretty hyphens-none">
				<p>Hi! I’m <SocialLink href={Socials.GITHUB}>Ilya Kruchinin</SocialLink>.</p>

				<p>
					I’m a <strong>Senior Developer</strong> at Web3 Project, where I build performant, user-friendly
					interfaces enabling seamless swaps and other crypto-related operations and services.
				</p>

				<p>I also work with several other SaaS teams on a project basis.</p>

				<p>
					Previously, I worked with various startups, focusing on solving real world business
					problems through innovative solutions. I hold a B.Sc. in Information Technologies, and my
					primary interests lie in modern web technologies, software architecture, and effective
					team collaboration and management.
				</p>
			</div>
		</div>
	</main>
</Layout>
