---

---

<div class="tamagotchi" id="tamagotchi">
	<button class="pet-button" type="button" aria-label="Poke the pet">
		<div class="pet-body">
			<span class="puff" aria-hidden="true">
				<svg viewBox="0 0 16 16" class="puff-svg" xmlns="http://www.w3.org/2000/svg">
					<rect x="2" y="6" width="2" height="2" fill="#fde047"></rect>
					<rect x="12" y="6" width="2" height="2" fill="#f0abfc"></rect>
					<rect x="6" y="2" width="2" height="2" fill="#7dd3fc"></rect>
					<rect x="6" y="12" width="2" height="2" fill="#fde047"></rect>
					<rect x="3" y="3" width="1" height="1" fill="#fff"></rect>
					<rect x="12" y="3" width="1" height="1" fill="#fff"></rect>
					<rect x="3" y="12" width="1" height="1" fill="#fff"></rect>
					<rect x="12" y="12" width="1" height="1" fill="#fff"></rect>
				</svg>
			</span>

			<svg viewBox="0 0 16 16" class="pet pet-cat" xmlns="http://www.w3.org/2000/svg">
				<rect x="3" y="2" width="2" height="2" fill="#f5a4c7"></rect>
				<rect x="11" y="2" width="2" height="2" fill="#f5a4c7"></rect>
				<rect x="3" y="3" width="10" height="2" fill="#ffd0e3"></rect>
				<rect x="2" y="5" width="12" height="6" fill="#ffd0e3"></rect>
				<rect x="3" y="11" width="10" height="1" fill="#ffd0e3"></rect>
				<rect class="eye" x="5" y="6" width="2" height="3" fill="#222"></rect>
				<rect class="eye" x="9" y="6" width="2" height="3" fill="#222"></rect>
				<rect class="sparkle" x="5" y="6" width="1" height="1" fill="#fff"></rect>
				<rect class="sparkle" x="9" y="6" width="1" height="1" fill="#fff"></rect>
				<rect x="6" y="9" width="1" height="1" fill="#f5a4c7"></rect>
				<rect x="9" y="9" width="1" height="1" fill="#f5a4c7"></rect>
				<rect x="7" y="10" width="2" height="1" fill="#c4517a"></rect>
				<rect class="leg leg-l" x="4" y="12" width="2" height="2" fill="#ffb1d0"></rect>
				<rect class="leg leg-r" x="10" y="12" width="2" height="2" fill="#ffb1d0"></rect>
			</svg>

			<svg viewBox="0 0 16 16" class="pet pet-frog" xmlns="http://www.w3.org/2000/svg">
				<rect x="3" y="2" width="2" height="2" fill="#7ec850"></rect>
				<rect x="11" y="2" width="2" height="2" fill="#7ec850"></rect>
				<rect x="3" y="3" width="2" height="1" fill="#fff"></rect>
				<rect x="11" y="3" width="2" height="1" fill="#fff"></rect>
				<rect class="eye" x="3" y="3" width="1" height="1" fill="#222"></rect>
				<rect class="eye" x="11" y="3" width="1" height="1" fill="#222"></rect>
				<rect x="2" y="4" width="12" height="7" fill="#7ec850"></rect>
				<rect x="3" y="11" width="10" height="1" fill="#7ec850"></rect>
				<rect x="5" y="6" width="6" height="3" fill="#bce39a"></rect>
				<rect x="6" y="9" width="4" height="1" fill="#3a6b1f"></rect>
				<rect class="leg leg-l" x="2" y="12" width="3" height="2" fill="#5a9c39"></rect>
				<rect class="leg leg-r" x="11" y="12" width="3" height="2" fill="#5a9c39"></rect>
			</svg>

			<svg viewBox="0 0 16 16" class="pet pet-fish" xmlns="http://www.w3.org/2000/svg">
				<rect x="1" y="6" width="2" height="4" fill="#fb923c"></rect>
				<rect x="2" y="5" width="1" height="1" fill="#fb923c"></rect>
				<rect x="2" y="10" width="1" height="1" fill="#fb923c"></rect>
				<rect x="3" y="6" width="9" height="4" fill="#fb923c"></rect>
				<rect x="4" y="5" width="7" height="1" fill="#fb923c"></rect>
				<rect x="4" y="10" width="7" height="1" fill="#fb923c"></rect>
				<rect x="5" y="7" width="6" height="2" fill="#fdba74"></rect>
				<rect class="eye" x="9" y="6" width="2" height="2" fill="#222"></rect>
				<rect x="10" y="6" width="1" height="1" fill="#fff"></rect>
				<rect x="13" y="8" width="1" height="1" fill="#c2410c"></rect>
				<rect class="fin fin-top" x="6" y="4" width="2" height="1" fill="#f97316"></rect>
				<rect class="fin fin-bottom" x="6" y="11" width="2" height="1" fill="#f97316"></rect>
			</svg>
		</div>
	</button>
</div>

<div class="pet-hint" id="pet-hint" aria-hidden="true">
	<div class="pet-hint-bubble">Нажми на меня!</div>
</div>

<script>
	const root = document.getElementById('tamagotchi');
	const button = root?.querySelector<HTMLButtonElement>('.pet-button');
	const hint = document.getElementById('pet-hint');

	if (root && button) {
		type Mode = 'cat' | 'frog' | 'fish';
		const PET_SIZE = 48;

		let mode: Mode = 'cat';
		let chaosTimer: number | null = null;
		let swimTimer: number | null = null;
		let bubbleTimer: number | null = null;

		let prevX = 0;
		let prevY = 0;
		let hasJumped = false;

		let swimX = 0;
		let swimY = 0;

		function clamp(value: number, min: number, max: number) {
			return Math.max(min, Math.min(max, value));
		}

		function spawnSplash(cx: number, cy: number) {
			const splash = document.createElement('div');
			splash.className = 'frog-splash';
			splash.style.left = `${cx}px`;
			splash.style.top = `${cy}px`;
			splash.innerHTML =
				'<svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
				'<rect x="2" y="6" width="2" height="2" fill="#7ec850"/>' +
				'<rect x="12" y="6" width="2" height="2" fill="#5a9c39"/>' +
				'<rect x="6" y="2" width="2" height="2" fill="#bce39a"/>' +
				'<rect x="6" y="12" width="2" height="2" fill="#7ec850"/>' +
				'<rect x="3" y="3" width="1" height="1" fill="#bce39a"/>' +
				'<rect x="12" y="3" width="1" height="1" fill="#5a9c39"/>' +
				'<rect x="3" y="12" width="1" height="1" fill="#7ec850"/>' +
				'<rect x="12" y="12" width="1" height="1" fill="#bce39a"/>' +
				'</svg>';
			document.body.appendChild(splash);
			window.setTimeout(() => splash.remove(), 700);
		}

		function jump() {
			const maxStep = 360;
			const dx = (Math.random() - 0.5) * maxStep * 2;
			const dy = (Math.random() - 0.5) * maxStep * 2;
			const x = clamp(Math.floor(prevX + dx), 0, Math.max(window.innerWidth - PET_SIZE, 0));
			const y = clamp(Math.floor(prevY + dy), 0, Math.max(window.innerHeight - PET_SIZE, 0));
			const r = Math.floor((Math.random() - 0.5) * 18);
			const flip = x < prevX ? -1 : 1;

			if (hasJumped) {
				spawnSplash(prevX + PET_SIZE / 2, prevY + PET_SIZE / 2);
			}

			prevX = x;
			prevY = y;
			hasJumped = true;

			root!.style.setProperty('--fx', `${x}px`);
			root!.style.setProperty('--fy', `${y}px`);
			root!.style.setProperty('--fr', `${r}deg`);
			root!.style.setProperty('--fsx', String(flip));

			chaosTimer = window.setTimeout(jump, 850 + Math.random() * 700);
		}

		function startChaos() {
			prevX = 0;
			prevY = Math.max(window.innerHeight - PET_SIZE, 0);
			hasJumped = false;
			jump();
		}

		function stopChaos() {
			if (chaosTimer !== null) {
				clearTimeout(chaosTimer);
				chaosTimer = null;
			}
			root!.style.removeProperty('--fx');
			root!.style.removeProperty('--fy');
			root!.style.removeProperty('--fr');
			root!.style.removeProperty('--fsx');
		}

		function swim() {
			const margin = PET_SIZE;
			const maxX = Math.max(window.innerWidth - margin, margin);
			const maxY = Math.max(window.innerHeight - margin, margin);
			const targetX = Math.floor(margin / 2 + Math.random() * Math.max(maxX - margin, 1));
			const targetY = Math.floor(margin / 2 + Math.random() * Math.max(maxY - margin, 1));
			const flip = targetX < swimX ? -1 : 1;
			swimX = targetX;
			swimY = targetY;
			root!.style.setProperty('--sx', `${targetX}px`);
			root!.style.setProperty('--sy', `${targetY}px`);
			root!.style.setProperty('--ssx', String(flip));
			swimTimer = window.setTimeout(swim, 3400 + Math.random() * 1400);
		}

		function startSwim() {
			swimX = Math.floor(window.innerWidth / 2);
			swimY = Math.floor(window.innerHeight / 2);
			swim();
		}

		function stopSwim() {
			if (swimTimer !== null) {
				clearTimeout(swimTimer);
				swimTimer = null;
			}
			root!.style.removeProperty('--sx');
			root!.style.removeProperty('--sy');
			root!.style.removeProperty('--ssx');
		}

		function spawnBubble() {
			if (!root) return;
			const rect = root.getBoundingClientRect();
			if (rect.width === 0) return;
			const facing =
				parseFloat(getComputedStyle(root).getPropertyValue('--ssx')) || 1;
			const tailOffset = -facing * (rect.width * 0.32);
			const cx = rect.left + rect.width / 2 + tailOffset + (Math.random() - 0.5) * 8;
			const cy = rect.top + rect.height / 2 + (Math.random() - 0.5) * 6;
			const size = 5 + Math.random() * 5;
			const drift = (Math.random() - 0.5) * 14;

			const bubble = document.createElement('div');
			bubble.className = 'fish-bubble';
			bubble.style.left = `${cx}px`;
			bubble.style.top = `${cy}px`;
			bubble.style.width = `${size}px`;
			bubble.style.height = `${size}px`;
			bubble.style.setProperty('--bubble-drift', `${drift}px`);
			document.body.appendChild(bubble);
			window.setTimeout(() => bubble.remove(), 2000);
		}

		function startBubbles() {
			function tick() {
				spawnBubble();
				bubbleTimer = window.setTimeout(tick, 550 + Math.random() * 700);
			}
			bubbleTimer = window.setTimeout(tick, 350);
		}

		function stopBubbles() {
			if (bubbleTimer !== null) {
				clearTimeout(bubbleTimer);
				bubbleTimer = null;
			}
		}

		const HINT_KEY = 'tamagotchi-hint-dismissed';
		let hintDismissed = false;
		let hintTimer: number | null = null;
		let hintRaf: number | null = null;

		try {
			hintDismissed = localStorage.getItem(HINT_KEY) === '1';
		} catch {}

		function followCat() {
			if (!hint || !root) return;
			const rect = root.getBoundingClientRect();
			hint.style.left = `${rect.left + rect.width / 2}px`;
			hint.style.top = `${rect.top - 8}px`;
			hintRaf = requestAnimationFrame(followCat);
		}

		function showHint() {
			if (!hint || hintDismissed) return;
			hint.classList.add('show');
			followCat();
		}

		function hideHint() {
			if (hintDismissed) return;
			hintDismissed = true;
			try {
				localStorage.setItem(HINT_KEY, '1');
			} catch {}
			hint?.classList.remove('show');
			if (hintTimer !== null) {
				clearTimeout(hintTimer);
				hintTimer = null;
			}
			if (hintRaf !== null) {
				cancelAnimationFrame(hintRaf);
				hintRaf = null;
			}
		}

		if (!hintDismissed && hint) {
			hintTimer = window.setTimeout(showHint, 3000);
		}

		button.addEventListener('click', () => {
			hideHint();
			const next: Mode = mode === 'cat' ? 'frog' : mode === 'frog' ? 'fish' : 'cat';

			root.classList.remove('puffing');
			void root.offsetWidth;
			root.classList.add('puffing');

			if (mode === 'frog') stopChaos();
			if (mode === 'fish') {
				stopSwim();
				stopBubbles();
			}

			root.classList.toggle('frog', next === 'frog');
			root.classList.toggle('fish', next === 'fish');

			if (next === 'frog') startChaos();
			if (next === 'fish') {
				startSwim();
				startBubbles();
			}

			mode = next;
		});
	}
</script>

<style>
	.tamagotchi {
		position: fixed;
		bottom: 0;
		left: 0;
		width: 48px;
		height: 48px;
		pointer-events: none;
		z-index: 40;
		animation: walk 28s linear infinite;
	}

	.tamagotchi.frog {
		top: 0;
		bottom: auto;
		animation: none;
		transform: translate(var(--fx, 0px), var(--fy, 0px)) rotate(var(--fr, 0deg))
			scaleX(var(--fsx, 1));
		transition:
			transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1),
			top 0s,
			bottom 0s;
	}

	.tamagotchi.fish {
		top: 0;
		bottom: auto;
		animation: none;
		transform: translate(var(--sx, 0px), var(--sy, 0px)) scaleX(var(--ssx, 1));
		transition:
			transform 3.2s cubic-bezier(0.45, 0, 0.55, 1),
			top 0s,
			bottom 0s;
	}

	.pet-button {
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: none;
		pointer-events: auto;
		cursor: pointer;
	}

	.pet-button:focus-visible {
		outline: 2px solid #c4517a;
		outline-offset: 2px;
		border-radius: 4px;
	}

	.pet-body {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.tamagotchi:not(.frog):not(.fish) .pet-body {
		animation: cat-hop 4.6s ease-in-out infinite;
	}

	.pet {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
		filter: drop-shadow(0 1px 0 rgba(0, 0, 0, 0.15));
		transition: opacity 0.18s;
		animation: bob 0.5s steps(2) infinite;
	}

	.pet-frog,
	.pet-fish {
		opacity: 0;
	}

	.frog .pet-cat,
	.fish .pet-cat {
		opacity: 0;
	}

	.frog .pet-frog {
		opacity: 1;
	}

	.fish .pet-fish {
		opacity: 1;
		animation: fish-bob 1.6s ease-in-out infinite;
	}

	.puff {
		position: absolute;
		inset: -25%;
		width: 150%;
		height: 150%;
		opacity: 0;
		pointer-events: none;
	}

	.puff-svg {
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
	}

	.puffing .puff {
		animation: puff 0.5s ease-out forwards;
	}

	.leg {
		animation: step 0.5s steps(2) infinite;
	}

	.leg-r {
		animation-delay: 0.25s;
	}

	.fin {
		animation: fin-flap 0.45s steps(2) infinite;
	}

	.fin-bottom {
		animation-delay: 0.22s;
	}

	.eye {
		transform-origin: center;
		animation: blink 5s infinite;
	}

	@keyframes walk {
		0% {
			transform: translateX(0) scaleX(1);
		}
		49% {
			transform: translateX(calc(100vw - 48px)) scaleX(1);
		}
		50% {
			transform: translateX(calc(100vw - 48px)) scaleX(-1);
		}
		99% {
			transform: translateX(0) scaleX(-1);
		}
		100% {
			transform: translateX(0) scaleX(1);
		}
	}

	@keyframes bob {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-1px);
		}
	}

	@keyframes fish-bob {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-2px);
		}
	}

	@keyframes cat-hop {
		0%,
		78%,
		100% {
			transform: translateY(0);
		}
		86% {
			transform: translateY(-14px);
		}
		92% {
			transform: translateY(-4px);
		}
		96% {
			transform: translateY(-1px);
		}
	}

	@keyframes step {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-1px);
		}
	}

	@keyframes fin-flap {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(1px);
		}
	}

	@keyframes blink {
		0%,
		92%,
		96%,
		100% {
			transform: scaleY(1);
		}
		94% {
			transform: scaleY(0.1);
		}
	}

	@keyframes puff {
		0% {
			transform: scale(0.3) rotate(0deg);
			opacity: 1;
		}
		100% {
			transform: scale(1.6) rotate(45deg);
			opacity: 0;
		}
	}

	.pet-hint {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 41;
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, -100%);
		transition: opacity 0.25s ease;
	}

	.pet-hint.show {
		opacity: 1;
	}

	.pet-hint-bubble {
		position: relative;
		padding: 5px 9px;
		border: 2px solid #1f2937;
		border-radius: 7px;
		background: #fff;
		color: #1f2937;
		font:
			11px/1.2 ui-monospace,
			monospace;
		white-space: nowrap;
		box-shadow: 2px 2px 0 #1f2937;
		animation: hint-bob 1.7s ease-in-out infinite;
	}

	.pet-hint-bubble::before,
	.pet-hint-bubble::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: -8px;
		width: 0;
		height: 0;
		border-left: 6px solid transparent;
		border-right: 6px solid transparent;
		border-top: 8px solid #1f2937;
		transform: translateX(-50%);
	}

	.pet-hint-bubble::after {
		bottom: -5px;
		border-left-width: 4px;
		border-right-width: 4px;
		border-top: 6px solid #fff;
	}

	@keyframes hint-bob {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-3px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tamagotchi,
		.tamagotchi.frog,
		.tamagotchi.fish,
		.pet-body,
		.pet,
		.leg,
		.fin,
		.eye,
		.puff,
		.pet-hint-bubble {
			animation: none !important;
			transition: none !important;
		}
	}
</style>

<style is:global>
	.frog-splash {
		position: fixed;
		width: 56px;
		height: 56px;
		margin-top: -28px;
		margin-left: -28px;
		pointer-events: none;
		z-index: 39;
		animation: frog-splash-anim 0.6s ease-out forwards;
	}

	.frog-splash svg {
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
	}

	@keyframes frog-splash-anim {
		0% {
			transform: scale(0.25) rotate(0deg);
			opacity: 1;
		}
		100% {
			transform: scale(1.7) rotate(40deg);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.frog-splash {
			display: none;
		}
	}

	.fish-bubble {
		position: fixed;
		pointer-events: none;
		z-index: 39;
		margin-top: -4px;
		margin-left: -4px;
		border: 1px solid rgba(56, 189, 248, 0.6);
		border-radius: 50%;
		background: rgba(186, 230, 253, 0.55);
		box-shadow: inset 1px 1px 0 rgba(255, 255, 255, 0.8);
		animation: fish-bubble-rise 1.9s ease-out forwards;
	}

	@keyframes fish-bubble-rise {
		0% {
			transform: translate(0, 4px) scale(0.4);
			opacity: 0;
		}
		20% {
			opacity: 0.85;
		}
		100% {
			transform: translate(var(--bubble-drift, 0px), -44px) scale(1);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.fish-bubble {
			display: none;
		}
	}
</style>
