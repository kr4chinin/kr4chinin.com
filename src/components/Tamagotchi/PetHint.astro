<div class="pet-hint" id="pet-hint" aria-hidden="true">
	<div class="pet-hint-bubble">
		<span class="pet-hint-text">Click!</span>
		<svg
			class="pet-hint-tail"
			viewBox="0 0 8 4"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
		>
			<rect x="0" y="0" width="8" height="1" fill="#1f2937"></rect>
			<rect x="1" y="1" width="6" height="1" fill="#1f2937"></rect>
			<rect x="2" y="2" width="4" height="1" fill="#1f2937"></rect>
			<rect x="3" y="3" width="2" height="1" fill="#1f2937"></rect>
		</svg>
	</div>
</div>

<style>
	.pet-hint {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 41;
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, -100%);
		transition: opacity 0.25s ease;
	}

	.pet-hint.show {
		opacity: 1;
	}

	.pet-hint-bubble {
		position: relative;
		padding: 4px 8px;
		border: 2px solid #1f2937;
		background: #fff;
		color: #1f2937;
		font:
			700 12px/1 ui-monospace,
			monospace;
		letter-spacing: 0.5px;
		white-space: nowrap;
		box-shadow: 2px 2px 0 #1f2937;
		animation: hint-bob 0.6s steps(2) infinite;
	}

	.pet-hint-tail {
		position: absolute;
		left: 50%;
		top: 100%;
		display: block;
		width: 16px;
		height: 8px;
		margin-left: -8px;
		image-rendering: pixelated;
	}

	@keyframes hint-bob {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-2px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pet-hint-bubble {
			animation: none !important;
		}
	}
</style>
