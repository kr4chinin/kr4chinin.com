---
import CatSprite from './CatSprite.astro';
import FishSprite from './FishSprite.astro';
import FrogSprite from './FrogSprite.astro';
import PetHint from './PetHint.astro';
import PuffEffect from './PuffEffect.astro';
---

<div class="tamagotchi" id="tamagotchi">
	<button class="pet-button" type="button" aria-label="Poke the pet">
		<div class="pet-body">
			<PuffEffect />
			<CatSprite />
			<FrogSprite />
			<FishSprite />
		</div>
	</button>
</div>

<PetHint />

<script>
	import { initTamagotchi } from './tamagotchi.client';
	initTamagotchi();
</script>

<style>
	.tamagotchi {
		position: fixed;
		bottom: 0;
		left: 0;
		width: 48px;
		height: 48px;
		pointer-events: none;
		z-index: 40;
		animation: walk 28s linear infinite;
	}

	.tamagotchi.frog {
		top: 0;
		bottom: auto;
		animation: none;
		transform: translate(var(--fx, 0px), var(--fy, 0px)) rotate(var(--fr, 0deg))
			scaleX(var(--fsx, 1));
		transition:
			transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1),
			top 0s,
			bottom 0s;
	}

	.tamagotchi.fish {
		top: 0;
		bottom: auto;
		animation: none;
		transform: translate(var(--sx, 0px), var(--sy, 0px)) scaleX(var(--ssx, 1));
		transition:
			transform 3.2s cubic-bezier(0.45, 0, 0.55, 1),
			top 0s,
			bottom 0s;
	}

	.pet-button {
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: none;
		pointer-events: auto;
		cursor: pointer;
	}

	.pet-button:focus-visible {
		outline: 2px solid #c4517a;
		outline-offset: 2px;
		border-radius: 4px;
	}

	.pet-body {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.tamagotchi:not(.frog):not(.fish) .pet-body {
		animation: cat-hop 4.6s ease-in-out infinite;
	}

	.tamagotchi :global(.pet) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
		filter: drop-shadow(0 1px 0 rgba(0, 0, 0, 0.15));
		transition: opacity 0.18s;
		animation: bob 0.5s steps(2) infinite;
	}

	.tamagotchi :global(.pet-frog),
	.tamagotchi :global(.pet-fish) {
		opacity: 0;
	}

	.tamagotchi.frog :global(.pet-cat),
	.tamagotchi.fish :global(.pet-cat) {
		opacity: 0;
	}

	.tamagotchi.frog :global(.pet-frog) {
		opacity: 1;
	}

	.tamagotchi.fish :global(.pet-fish) {
		opacity: 1;
		animation: fish-bob 1.6s ease-in-out infinite;
	}

	.tamagotchi :global(.puff) {
		position: absolute;
		inset: -25%;
		width: 150%;
		height: 150%;
		opacity: 0;
		pointer-events: none;
	}

	.tamagotchi :global(.puff-svg) {
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
	}

	.tamagotchi.puffing :global(.puff) {
		animation: puff 0.5s ease-out forwards;
	}

	.tamagotchi :global(.leg) {
		animation: step 0.5s steps(2) infinite;
	}

	.tamagotchi :global(.leg-r) {
		animation-delay: 0.25s;
	}

	.tamagotchi :global(.fin) {
		animation: fin-flap 0.45s steps(2) infinite;
	}

	.tamagotchi :global(.fin-bottom) {
		animation-delay: 0.22s;
	}

	.tamagotchi :global(.eye) {
		transform-origin: center;
		animation: blink 5s infinite;
	}

	@keyframes walk {
		0% {
			transform: translateX(0) scaleX(1);
		}
		49% {
			transform: translateX(calc(100vw - 48px)) scaleX(1);
		}
		50% {
			transform: translateX(calc(100vw - 48px)) scaleX(-1);
		}
		99% {
			transform: translateX(0) scaleX(-1);
		}
		100% {
			transform: translateX(0) scaleX(1);
		}
	}

	@keyframes bob {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-1px);
		}
	}

	@keyframes fish-bob {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-2px);
		}
	}

	@keyframes cat-hop {
		0%,
		78%,
		100% {
			transform: translateY(0);
		}
		86% {
			transform: translateY(-14px);
		}
		92% {
			transform: translateY(-4px);
		}
		96% {
			transform: translateY(-1px);
		}
	}

	@keyframes step {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-1px);
		}
	}

	@keyframes fin-flap {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(1px);
		}
	}

	@keyframes blink {
		0%,
		92%,
		96%,
		100% {
			transform: scaleY(1);
		}
		94% {
			transform: scaleY(0.1);
		}
	}

	@keyframes puff {
		0% {
			transform: scale(0.3) rotate(0deg);
			opacity: 1;
		}
		100% {
			transform: scale(1.6) rotate(45deg);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tamagotchi,
		.tamagotchi.frog,
		.tamagotchi.fish,
		.pet-body,
		.tamagotchi :global(.pet),
		.tamagotchi :global(.leg),
		.tamagotchi :global(.fin),
		.tamagotchi :global(.eye),
		.tamagotchi :global(.puff) {
			animation: none !important;
			transition: none !important;
		}
	}
</style>

<style is:global>
	.frog-splash {
		position: fixed;
		width: 56px;
		height: 56px;
		margin-top: -28px;
		margin-left: -28px;
		pointer-events: none;
		z-index: 39;
		animation: frog-splash-anim 0.6s ease-out forwards;
	}

	.frog-splash svg {
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
	}

	@keyframes frog-splash-anim {
		0% {
			transform: scale(0.25) rotate(0deg);
			opacity: 1;
		}
		100% {
			transform: scale(1.7) rotate(40deg);
			opacity: 0;
		}
	}

	.fish-bubble {
		position: fixed;
		pointer-events: none;
		z-index: 39;
		margin-top: -4px;
		margin-left: -4px;
		border: 1px solid rgba(56, 189, 248, 0.6);
		border-radius: 50%;
		background: rgba(186, 230, 253, 0.55);
		box-shadow: inset 1px 1px 0 rgba(255, 255, 255, 0.8);
		animation: fish-bubble-rise 1.9s ease-out forwards;
	}

	@keyframes fish-bubble-rise {
		0% {
			transform: translate(0, 4px) scale(0.4);
			opacity: 0;
		}
		20% {
			opacity: 0.85;
		}
		100% {
			transform: translate(var(--bubble-drift, 0px), -44px) scale(1);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.frog-splash,
		.fish-bubble {
			display: none;
		}
	}
</style>
