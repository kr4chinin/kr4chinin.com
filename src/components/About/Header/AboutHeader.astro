---
import { Image } from 'astro:assets';

import { Socials } from '~/constants';
import SocialLink from './SocialLink.astro';
import Navigation from './Navigation.astro';
import type { LinkItem } from '~/models/LinkItem';
import LocationIcon from '~/assets/location.svg';

import avatarImage from '~/assets/avatar.png';

const delimiter = '•';

const socials: LinkItem[] = [
	{ href: Socials.TELEGRAM, label: '@kr4chinin' },
	{ href: Socials.GITHUB, label: 'github' },
	{ href: Socials.LINKED_IN, label: 'linkedin' },
	{ href: Socials.X, label: 'x' },
];
---

<header class="flex flex-col shadow-sm">
	<div class="bg-zinc-200">
		<div class="mx-auto flex max-w-3xl gap-8 px-4 py-6 max-sm:flex-col">
			<div class="h-[150px] w-[150px] max-sm:h-[125px] max-sm:w-[125px]">
				<Image
					priority
					src={avatarImage}
					alt="Ilya's avatar"
					class="h-full w-full rounded-full shadow-sm"
				/>
			</div>

			<div class="flex flex-col gap-4">
				<h1 class="text-4xl font-bold text-gray-900 max-sm:text-3xl">Ilya Kruchinin</h1>

				<div class="flex items-center gap-4">
					<h2>Full Stack Developer</h2>

					<address class="flex items-center gap-2 not-italic">
						<a
							class="flex items-center gap-2 text-inherit no-underline visited:text-inherit hover:underline"
							href="https://en.wikipedia.org/wiki/Bali"
							target="_blank"
							rel="noopener noreferrer"
						>
							<LocationIcon class="h-4 w-4" aria-hidden="true" />

							<h2>Bali</h2>
						</a>
					</address>
				</div>

				<h2>Engineering solutions</h2>

				<div class="flex items-center gap-2">
					{
						socials.map((social, idx) => (
							<>
								<SocialLink href={social.href}>{social.label}</SocialLink>
								{idx < socials.length - 1 && <i class="max-sm:text-xs">{delimiter}</i>}
							</>
						))
					}
				</div>
			</div>
		</div>
	</div>

	<Navigation />
</header>
