---
import type { LinkItem } from '~/models/LinkItem';
import NavigationLink from './NavigationLink.astro';

const links: LinkItem[] = [
	{ href: '/', label: 'About' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/projects', label: 'Projects' },
];
---

<div class="bg-slate-200">
	<nav class="mx-auto max-w-3xl px-4 py-4">
		<ul class="flex gap-6">
			{
				links.map(link => (
					<li>
						<NavigationLink href={link.href}>{link.label}</NavigationLink>
					</li>
				))
			}
		</ul>
	</nav>
</div>
